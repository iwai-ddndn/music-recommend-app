# 秘密鍵はリポジトリに含めない。値は .env.local（ローカル）や Vercel / GitHub の Secrets に設定する。

# --- Apple Music（MusicKit on the Web / Apple Music API） ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 の中身。改行は \n でも可
APPLE_PRIVATE_KEY=

# --- X API（目利きのポスト収集） ---
X_BEARER_TOKEN=
# 当月の推定費用がこの額に達したら収集を止める（未設定だと本番では収集しない）
X_MONTHLY_BUDGET_USD=

# --- Last.fm（人気度＝リスナー数） ---
LASTFM_API_KEY=

# --- SoundCloud（任意: /resolve で詳細を補完。無くても oEmbed で動く） ---
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# true のときは外部APIを呼ばず fixtures/ のサンプル応答とローカルDB（.data/）を使う。
# 未設定でも Supabase の URL が無ければ fixtures モードになる。
USE_FIXTURES=

# --- 任意 ---
# フッターに出す掲載停止の申し出先
NEXT_PUBLIC_CONTACT_EMAIL=
# プロダクト名（未定のため既定は「マイナー曲発掘プレイヤー」）
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=
